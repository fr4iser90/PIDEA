# Git & IDE
.git
.gitignore
.cursor
.vscode

# Never copy dependency trees or build artifacts (saves context size & cache)
node_modules
**/node_modules
backend/node_modules
frontend/node_modules
**/dist
**/build
.next
.cache

# Secrets — do not send to Docker daemon or bake into images
.env
.env.*
!.env.example

# Logs & test output (backend/logs can be multi-GB — kills context size & Docker cache)
*.log
logs
**/logs
backend/logs
backend/coverage
backend/.jest-cache
coverage
.nyc_output

# Large paths not referenced by backend/frontend Dockerfiles
content-library
docs
