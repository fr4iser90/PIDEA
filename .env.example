# Environment
NODE_ENV=development
# Domain (production only)
DOMAIN=

# Database — .env is the single source of truth. DATABASE_TYPE=postgres or sqlite (default sqlite if unset).
# With postgres, a SQLite fallback file DB is used if Postgres is unreachable (see AutoSecurityManager).
# Postgres: host/port are resolved in code (localhost vs container DB). Optional overrides: DB_HOST, DB_PORT, DB_DOCKER_SERVICE_HOST.
DB_PORT=5432
DB_NAME=pidea
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
# Must match DB_* — Postgres container + healthcheck (docker-compose)
POSTGRES_DB=pidea
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_TYPE=postgres
# Only for external tools that need a URL; app does not require DATABASE_URL
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Required for first admin user (create-default-user); no defaults — see README
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Development (for npm run dev)
# In Docker images, same-origin URLs are detected via /.dockerenv (see backend/config/docker-runtime.js).
VITE_FRONTEND_URL=http://localhost:4000
VITE_BACKEND_URL=http://localhost:3000